{
  "name": "tamlois-clinic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "gallery:optimize": "node scripts/optimize-gallery.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tamlois-owner-auth \"npm run test:rules:unit\"",
    "test:rules:unit": "vitest run --config vitest.rules.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "playwright test --config playwright.firebase.config.ts",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "@hookform/resolvers": "^5.2.1",
    "@tailwindcss/vite": "^4.1.12",
    "date-fns": "^4.1.0",
    "firebase": "^12.1.0",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "tailwindcss": "^4.1.12",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "firebase-tools": "^15.28.1",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
