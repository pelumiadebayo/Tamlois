VITE_APP_MODE=demo
VITE_SITE_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Browser routing/feedback only. The same UID must also replace the documented
# ownerUid() value in firestore.rules, which is the authoritative security check.
VITE_FIREBASE_ADMIN_UID=
VITE_USE_FIREBASE_EMULATORS=false

# Public retail link only. Product data and checkout remain in Paystack Storefront.
VITE_PAYSTACK_STOREFRONT_URL=https://paystack.shop/tamls

VITE_GA_MEASUREMENT_ID=

# Browser display fallbacks only. Firebase Functions and Firestore are the
# authority for enabled payment modes, deposits, prices and hold duration.
VITE_ENABLE_CLIENT_PHOTO_UPLOADS=false
VITE_DEFAULT_PAYMENT_MODE=clinic
VITE_DEFAULT_DEPOSIT_PERCENTAGE=50

VITE_BUSINESS_WHATSAPP=
VITE_BUSINESS_PHONE=
VITE_BUSINESS_EMAIL=
VITE_GOOGLE_MAPS_URL=

# SERVER-ONLY FIREBASE FUNCTIONS CONFIGURATION (documentation only)
# Never add these as VITE_ variables or commit their values here.
# Secret Manager: PAYSTACK_SECRET_KEY, PAYSTACK_WEBHOOK_SECRET
# Firebase string parameters: APP_PUBLIC_URL, ALLOWED_FRONTEND_ORIGINS
# Firebase boolean parameter: ENFORCE_APP_CHECK (true in production)
